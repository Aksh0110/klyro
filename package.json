{
  "name": "klyro",
  "version": "1.0.0",
  "private": true,
  "description": "Klyro Multi-Vertical SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pm2:start": "npm run build --workspace=api && pm2 start ecosystem.config.js --only klyro-api,klyro-web",
    "pm2:start:dev": "pm2 start ecosystem.config.js --only klyro-api-watch,klyro-web",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "pm2:delete": "pm2 delete ecosystem.config.js"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
